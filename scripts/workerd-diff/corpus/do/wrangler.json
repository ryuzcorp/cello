{
  "name": "do",
  "main": "index.js",
  "compatibility_date": "2026-11-24",
  "no_bundle": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "OBJ",
        "class_name": "Probe"
      },
      {
        "name": "TIMER",
        "class_name": "Timer"
      },
      {
        "name": "THROWER",
        "class_name": "Thrower"
      },
      {
        "name": "RPCDO",
        "class_name": "Rpc"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Probe"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Timer",
        "Thrower"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "Rpc"
      ]
     }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "do-kv" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "do-bucket" }],
  "d1_databases": [{ "binding": "DB", "database_name": "do-d1" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "do-queue" }]
  }
}
